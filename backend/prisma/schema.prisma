generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  PRODUCTION
}

enum AttendanceStatus {
  HADIR
  TERLAMBAT
  IZIN
  SAKIT
  CUTI
  ALPA
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         Role      @default(PRODUCTION)
  phone        String?
  isActive     Boolean   @default(true) @map("is_active")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  attendances         Attendance[] @relation("UserAttendances")
  recordedAttendances Attendance[] @relation("RecordedByAttendances")

  @@map("users")
}

model WorkSetting {
  id               String   @id @default("default")
  workStartTime    String   @default("08:00") @map("work_start_time")
  lateToleranceMin Int      @default(15) @map("late_tolerance_min")
  workEndTime      String   @default("17:00") @map("work_end_time")
  workDays         String   @default("1,2,3,4,5,6") @map("work_days")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("work_settings")
}

model Attendance {
  id           String           @id @default(cuid())
  userId       String           @map("user_id")
  date         DateTime         @db.Date
  checkInAt    DateTime?        @map("check_in_at")
  checkOutAt   DateTime?        @map("check_out_at")
  status       AttendanceStatus @default(HADIR)
  workMinutes  Int              @default(0) @map("work_minutes")
  note         String?          @db.Text
  recordedById String?          @map("recorded_by_id")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  user       User  @relation("UserAttendances", fields: [userId], references: [id])
  recordedBy User? @relation("RecordedByAttendances", fields: [recordedById], references: [id])

  @@unique([userId, date])
  @@index([date])
  @@map("attendances")
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  phone     String
  company   String?
  address   String?   @db.Text
  notes     String?   @db.Text
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([name])
  @@index([phone])
  @@map("customers")
}
