generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  PRODUCTION
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         Role      @default(PRODUCTION)
  phone        String?
  isActive     Boolean   @default(true) @map("is_active")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model WorkSetting {
  id               String   @id @default("default")
  workStartTime    String   @default("08:00") @map("work_start_time")
  lateToleranceMin Int      @default(15) @map("late_tolerance_min")
  workEndTime      String   @default("17:00") @map("work_end_time")
  workDays         String   @default("1,2,3,4,5,6") @map("work_days")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("work_settings")
}
